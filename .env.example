# The assistant's API key. Copy this file to .env and put a real key in it.
#
# It is read by the dev server, never by the browser - which is why it has no
# VITE_ prefix. Anything named VITE_* is handed to the page, and a key in the
# page is a key anyone viewing it can read.
#
# Get one from https://console.anthropic.com. A Claude subscription does not
# cover API usage; these are billed separately.
#
# Restart `npm run dev` after changing this.
ANTHROPIC_API_KEY=sk-ant-...
